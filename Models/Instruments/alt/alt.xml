<?xml version="1.0" encoding="UTF-8"?>

<!--	Bendix-King KEA-130A / United Inst. Series 5035 Encoding Altimeter and 5934 Series Altimeter
	
	2023 Bea Wolf
	
	references:	https://www.unitedinst.com/Products/Altimeters/
			https://www.unitedinst.com/Products/SpecificationsSheets/d116796.aspx?type=view
			https://www.preferredairparts.com/serviceable-bendix-king-kea-130-encoding-altimeter-35k-pn-066-03064-0002
			https://www.seaerospace.com/sales/product/BendixKing/KEA-130A
			https://www.unitedinst.com/Products/SpecificationsSheets/d116800.aspx?type=view
			
-->

<PropertyList>
	
	<path>alt.ac</path>
	
	<params>
		<light-property type="string">systems/electrical/outputs/instrument-lights-norm</light-property>
		<encoding type="bool">false</encoding>
		<altitude type="string">instrumentation/altimeter[0]/indicated-altitude-ft</altitude>
		<qnh-setting type="string">instrumentation/altimeter[0]/setting-inhg</qnh-setting>
	</params>
	
	<effect>
		<inherits-from>Models/Effects/interior/instrument-glass</inherits-from>
		<object-name>alt.glass</object-name>
	</effect>
	
	<animation>
		<type>material</type>
		<object-name>alt</object-name>
		<object-name>alt.face</object-name>
		<object-name>alt.face.encoding</object-name>
		<object-name>alt.needle.100</object-name>
		<object-name>alt.needle.1000</object-name>
		<object-name>alt.needle.10000</object-name>
		<object-name>alt.qnh_knob</object-name>
		<object-name>alt.qnh_scale</object-name>
		<emission>
			<red>   0.6 </red>
			<green> 0.6 </green>
			<blue>  0.6 </blue>
			<factor-prop alias="/params/light-property" />
		</emission>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>alt.needle.100</object-name>
		<property alias="/params/altitude" />
		<factor> 0.36 </factor>
		<axis>
			<x> -1 </x>
		</axis>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>alt.needle.1000</object-name>
		<property alias="/params/altitude" />
		<factor> 0.036 </factor>
		<axis>
			<x> -1 </x>
		</axis>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>alt.needle.10000</object-name>
		<property alias="/params/altitude" />
		<factor> 0.0036 </factor>
		<axis>
			<x> -1 </x>
		</axis>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>alt.qnh_scale</object-name>
		<property alias="/params/qnh-setting" />
		<interpolation>
			<entry><ind> 28.1 </ind><dep>   0 </dep></entry>
			<entry><ind> 31.0 </ind><dep> 300 </dep></entry>
		</interpolation>
		<axis>
			<x> 1 </x>
		</axis>
	</animation>
	
	<animation>
		<type>knob</type>
		<object-name>alt.qnh_knob</object-name>
		<property alias="/params/qnh-setting" />
		<factor>15.0</factor>
		<axis>
			<x>1</x>
		</axis>
		<center>
			<y-m>-0.0297</y-m>
			<z-m>-0.0297</z-m>
		</center>
		<action>
			<binding>
				<command>property-adjust</command>
				<property alias="/params/qnh-setting" />
				<factor> 0.01 </factor>
				<min>  28.1 </min>
				<max>  31.0 </max>
				<wrap>  0   </wrap>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>alt-setting</tooltip-id>
				<label>Altimeter In Hg: %5.2f</label>
				<property alias="/params/qnh-setting" />
			</binding>
		</hovered>
	</animation>
	
	
	<!-- Altitude Guage Tooltip -->
	<animation>
		<type>pick</type>
		<object-name>alt</object-name>
		<action></action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>altitude</tooltip-id>
				<label>Altitude: %5d ft</label>
				<property alias="/params/altitude" />
			</binding>
		</hovered>
	</animation>
	
	<!-- Label Text -->
	<text>
		<name>LabelTextEnc</name>
		<type type="string">literal</type>
		<text type="string">Encoding Altimeter</text>
		<draw-text type="bool">true</draw-text>
		<font>Helvetica.txf</font>
		<character-size type="double">0.020</character-size>
		<character-aspect-ratio type="double">1.0</character-aspect-ratio>
		<axis-alignment>yz-plane</axis-alignment>
		<max-height>0.2</max-height>
		<max-width>0.1</max-width>
		<font-resolution>
			<width type="int">32</width>
			<height type="int">32</height>
		</font-resolution>
		<alignment>center-center</alignment>
		<offsets>
			<x-m> 0.02</x-m>
			<y-m> 0.0 </y-m>
			<z-m> 0.0 </z-m>
		</offsets>
	</text>
	<text>
		<name>LabelText</name>
		<type type="string">literal</type>
		<text type="string">Altimeter</text>
		<draw-text type="bool">true</draw-text>
		<font>Helvetica.txf</font>
		<character-size type="double">0.020</character-size>
		<character-aspect-ratio type="double">1.0</character-aspect-ratio>
		<axis-alignment>yz-plane</axis-alignment>
		<max-height>0.2</max-height>
		<max-width>0.2</max-width>
		<font-resolution>
			<width type="int">32</width>
			<height type="int">32</height>
		</font-resolution>
		<alignment>center-center</alignment>
		<offsets>
			<x-m> 0.02</x-m>
			<y-m> 0.0 </y-m>
			<z-m> 0.0 </z-m>
		</offsets>
	</text>
	
	<animation>
		<type>material</type>
		<object-name>LabelText</object-name>
		<object-name>LabelTextEnc</object-name>
		<emission>
			<red>0.7</red>
			<green>0.7</green>
			<blue>0.7</blue>
		</emission>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>LabelText</object-name>
		<object-name>LabelTextEnc</object-name>
		<condition>
			<property>/sim/panel-hotspots</property>
		</condition>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>LabelTextEnc</object-name>
		<object-name>alt.face.encoding</object-name>
		<condition>
			<equals>
				<value alias="/params/encoding" />
				<value>1</value>
			</equals>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>LabelText</object-name>
		<object-name>alt.face</object-name>
		<condition>
			<equals>
				<value alias="/params/encoding" />
				<value>0</value>
			</equals>
		</condition>
	</animation>
	
</PropertyList>
