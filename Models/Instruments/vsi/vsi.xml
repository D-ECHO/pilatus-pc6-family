<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>
	
	<path>vsi.ac</path>
	
	<params>
		<light-property type="string">systems/electrical/outputs/instrument-lights-norm</light-property>
		<indicated-vs-fpm type="string">instrumentation/vertical-speed-indicator[0]/indicated-speed-fpm</indicated-vs-fpm>
	</params>
	
	<effect>
		<inherits-from>Models/Effects/interior/instrument-glass</inherits-from>
		<object-name>vsi.glass</object-name>
	</effect>
	
	<animation>
		<type>material</type>
		<object-name>vsi.face</object-name>
		<object-name>vsi.needle</object-name>
		<emission>
			<factor-prop alias="/params/light-property" />
			<red>   0.6 </red>
			<green> 0.6 </green>
			<blue>  0.6 </blue>
		</emission>
	</animation>
	
	<animation> 
		<type>rotate</type>
		<object-name>vsi.needle</object-name>
		<property alias="/params/indicated-vs-fpm" />
		<interpolation>
			<entry><ind> -2000 </ind><dep> -172 </dep></entry>
			<entry><ind> -1500 </ind><dep> -130 </dep></entry>
			<entry><ind> -1000 </ind><dep>  -81 </dep></entry>
			<entry><ind>  -500 </ind><dep>  -35 </dep></entry>
			<entry><ind>     0 </ind><dep>    0 </dep></entry>
			<entry><ind>   500 </ind><dep>   35 </dep></entry>
			<entry><ind>  1000 </ind><dep>   81 </dep></entry>
			<entry><ind>  1500 </ind><dep>  130 </dep></entry>
			<entry><ind>  2000 </ind><dep>  172 </dep></entry>
		</interpolation>
		<axis>
			<x> -1 </x>
		</axis>
	</animation>
	
</PropertyList>
