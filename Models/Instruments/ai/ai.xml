<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
	<path>ai.ac</path>
	<effect>
		<inherits-from>Models/Effects/interior/instrument-glass</inherits-from>
		<object-name>ai.glass</object-name>
	</effect>
	<animation>
		<type>material</type>
		<object-name>ai.horizon</object-name>
		<object-name>ai.roll</object-name>
		<object-name>ai.ac_symbol</object-name>
		<object-name>ai.ball</object-name>
		<emission>
			<red>   0.7 </red>
			<green> 0.4 </green>
			<blue>  0.4 </blue>
			<factor-prop>systems/electrical/outputs/instrument-lights-norm</factor-prop>s
		</emission>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>ai.horizon</object-name>
		<object-name>ai.roll</object-name>
		<property>instrumentation/attitude-indicator/indicated-roll-deg</property>
		<factor>1</factor>
		<axis>
			<x>  1 </x>
			<y>  0 </y>
			<z>  0 </z>
		</axis>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>ai.horizon</object-name>
		<property>instrumentation/attitude-indicator/indicated-pitch-deg-deg</property>
		<factor>0.000375</factor>
		<axis>
			<x>  0 </x>
			<y>  0 </y>
			<z>  1 </z>
		</axis>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>ai.ac_symbol</object-name>
		<property>instrumentation/attitude-indicator/horizon-offset-deg</property>
		<factor>0.000375</factor>
		<axis>
			<x>  0 </x>
			<y>  0 </y>
			<z>  1 </z>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>ai.ball</object-name>
		<property>instrumentation/slip-skid-ball/indicated-slip-skid</property>
		<factor>-10</factor>
		<axis>
			<x>  1 </x>
			<y>  0 </y>
			<z>  0 </z>
		</axis>
		<center>
			<z-m>0.07</z-m>
		</center>
	</animation>
	<animation>
		<type>knob</type>
		<object-name>ai.knob</object-name>
		<property>instrumentation/attitude-indicator/horizon-offset-deg</property>
		<factor>35</factor>
		<center>
			<z-m>-0.033442</z-m>
		</center>
		<axis>
			<x>1</x>
		</axis>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>instrumentation/attitude-indicator/horizon-offset-deg</property>
				<min>-10</min>
				<max>10</max>
				<factor>-1</factor>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>horizon_offset</tooltip-id>
				<label>Horizon offset: %2d deg</label>
				<measure-text>Horizon offset: -10 deg</measure-text>
				<property>instrumentation/attitude-indicator/horizon-offset-deg</property>
			</binding>
		</hovered>	
	</animation>
</PropertyList>
