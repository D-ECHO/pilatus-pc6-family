<?xml version="1.0"?>

<PropertyList>

	<path>asi.ac</path>

	<effect>
		<inherits-from>Models/Effects/interior/instrument-glass</inherits-from>
		<object-name>asi.glass</object-name>
	</effect>

	<animation>
		<type>material</type>
		<object-name>asi</object-name>
		<object-name>asi.needle</object-name>
		<emission>
			<red>0.30</red>
			<green>0.15</green>
			<blue>0.05</blue>
			<factor-prop>systems/electrical/outputs/instrument-lights-norm</factor-prop>
		</emission>
	</animation>

	<animation>
		<type>rotate</type>
	<object-name>asi.needle</object-name>
		<property>instrumentation/airspeed-indicator/indicated-speed-kt</property>
		<interpolation>
			<entry><ind>0  </ind><dep>0.0</dep></entry>
			<entry><ind>25 </ind><dep>13.0</dep></entry>   
			<entry><ind>30 </ind><dep>18.5</dep></entry> 
			<entry><ind>35 </ind><dep>25.0</dep></entry>
			<entry><ind>40 </ind><dep>32.0</dep></entry>
			<entry><ind>60 </ind><dep>70.0</dep></entry>
			<entry><ind>80 </ind><dep>118.0</dep></entry>
			<entry><ind>100</ind><dep>178.0</dep></entry>
			<entry><ind>120</ind><dep>218.0</dep></entry>
			<entry><ind>140</ind><dep>258.0</dep></entry>
			<entry><ind>160</ind><dep>298.0</dep></entry>
			<entry><ind>180</ind><dep>338.0</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
		<center>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</center>
	</animation>

</PropertyList>
