<?xml version="1.0"?>

<PropertyList>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>3</max-rate-of-change>
		<input>
			<condition>
				<property>instrumentation/nav[0]/in-range</property>
				<greater-than>
					<property>systems/electrical/outputs/nav[0]</property>
					<value>9.0</value>	
				</greater-than>
			</condition>
			<value>1</value>
		</input>
		<input>
			<value>0</value>
		</input>
		<output>/instrumentation/ki525a[0]/nav-flag</output>
	</filter>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>3</max-rate-of-change>
		<input>
			<condition>
				<greater-than>
					<property>systems/electrical/outputs/DG[0]</property>
					<value>9.0</value>	
				</greater-than>
				<greater-than>
					<property>instrumentation/heading-indicator-dg/spin</property>
					<value>0.9</value>	
				</greater-than>
			</condition>
			<value>1</value>
		</input>
		<input>
			<value>0</value>
		</input>
		<output>/instrumentation/ki525a[0]/hdg-flag</output>
	</filter>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>3</max-rate-of-change>
		<input>
			<condition>
				<property>instrumentation/nav[0]/to-flag</property>
			</condition>
			<value>1</value>
		</input>
		<input>
			<condition>
				<property>instrumentation/nav[0]/from-flag</property>
			</condition>
			<value>-1</value>
		</input>
		<input>
			<value>0</value>
		</input>
		<output>/instrumentation/ki525a[0]/to-from-flag</output>
	</filter>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>3</max-rate-of-change>
		<input>
			<expression>
				<product>
					<difference>
						<property>/instrumentation/heading-indicator-dg/indicated-heading-deg</property>
						<property>/instrumentation/magnetic-slaving-transmitter/indicated-heading-deg</property>
					</difference>
					<value>0.05</value>
				</product>
			</expression>
		</input>
		<min>-1.0</min>
		<max> 1.0</max>
		<output>/instrumentation/ka51b/heading-diff-norm</output>
	</filter>
</PropertyList>
