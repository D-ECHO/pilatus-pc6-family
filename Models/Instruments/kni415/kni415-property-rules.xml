<?xml version="1.0"?>

<PropertyList>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>500</max-rate-of-change>
		<input>
			<condition>
				<not>
					<property>/instrumentation/radar-altimeter/serviceable</property>
				</not>
			</condition>
			<value>0</value>
		</input>
		<input>
			<condition>
				<property>/instrumentation/radar-altimeter/test-button</property>
			</condition>
			<value>50</value>
		</input>
		<input>
			<property>/instrumentation/radar-altimeter/radar-altitude-ft</property>
		</input>
		<output>/instrumentation/radar-altimeter/indicated-altitude-ft</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<condition>
				<property>/instrumentation/radar-altimeter/serviceable</property>
				<not>
					<property>/instrumentation/radar-altimeter/dh-light-pressed</property>
				</not>
				<property>/instrumentation/radar-altimeter/dh-light-inhibit</property>
			</condition>
			<value>1</value>
		</input>
		<input>0</input>
		<output>/instrumentation/radar-altimeter/dh-press-func-set</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<condition>
				<property>/instrumentation/radar-altimeter/serviceable</property>
				<not>
					<property>/instrumentation/radar-altimeter/dh-light-pressed</property>
				</not>
				<not>
					<property>/instrumentation/radar-altimeter/dh-light-inhibit</property>
				</not>
			</condition>
			<value>1</value>
		</input>
		<input>0</input>
		<output>/instrumentation/radar-altimeter/dh-press-func-reset</output>
	</filter>
	<flipflop>
		<type>SR</type>
		<S>
			<property>/instrumentation/radar-altimeter/dh-press-func-set</property>
		</S>
		<R>
			<property>/instrumentation/radar-altimeter/dh-press-func-reset</property>
		</R>
		<output>/instrumentation/radar-altimeter/dh-press-function</output> <!-- 0 = set, 1 = rest -->
	</flipflop>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<condition>
				<property>/instrumentation/radar-altimeter/serviceable</property>
				<property>/instrumentation/radar-altimeter/dh-light-pressed</property>
				<not>
					<property>/instrumentation/radar-altimeter/dh-press-function</property>
				</not>
			</condition>
			<value>1</value>
		</input>
		<input>0</input>
		<output>/instrumentation/radar-altimeter/dh-light-set</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<condition>
				<property>/instrumentation/radar-altimeter/serviceable</property>
				<or>
					<property>/instrumentation/radar-altimeter/dh-light-pressed</property>
					<greater-than>
						<property>instrumentation/radar-altimeter/indicated-altitude-ft</property>
						<property>instrumentation/radar-altimeter/decision-height</property>
					</greater-than>
				</or>
			</condition>
			<value>1</value>
		</input>
		<input>0</input>
		<output>/instrumentation/radar-altimeter/dh-light-reset</output>
	</filter>
	<flipflop>
		<type>SR</type>
		<S>
			<property>/instrumentation/radar-altimeter/dh-light-set</property>
		</S>
		<R>
			<property>/instrumentation/radar-altimeter/dh-light-reset</property>
		</R>
		<output>/instrumentation/radar-altimeter/dh-light-inhibit</output>
	</flipflop>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>3</max-rate-of-change>
		<input>
			<condition>
				<or>
					<property>/instrumentation/radar-altimeter/test-button</property>
					<not>
						<property>/instrumentation/radar-altimeter/serviceable</property>
					</not>
				</or>
			</condition>
			<value>1</value>
		</input>
		<input>0</input>
		<output>/instrumentation/radar-altimeter/invalid-flag</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<condition>
				<less-than>
					<property>/systems/electrical/outputs/radar-altimeter</property>
					<value>9</value>
				</less-than>
			</condition>
			<value>0</value>
		</input>
		<input>1</input>
		<output>/instrumentation/radar-altimeter/serviceable</output>
	</filter>
</PropertyList>
