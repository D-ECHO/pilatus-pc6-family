	<!-- Controls -->
	<animation>
		<type>knob</type>
		<object-name>kt74.knob</object-name>
		<property>instrumentation/transponder/inputs/knob-mode</property>
		<interpolation>
			<entry>
				<ind> 0 </ind>
				<dep>0.0</dep>
			</entry>
			<entry>
				<ind> 1 </ind>
				<dep>40.0</dep>
			</entry>
			<entry>
				<ind> 4 </ind>
				<dep>80.0</dep>
			</entry>
			<entry>
				<ind> 5 </ind>
				<dep>130.0</dep>
			</entry>
		</interpolation>
		<center>
			<y-m> 0.0635</y-m>
			<z-m>-0.0008</z-m>
		</center>
		<axis>
			<x>-1</x>
		</axis>
		<action>
			<binding>
				<command>property-cycle</command>
				<property>instrumentation/transponder/inputs/knob-mode</property>
				<value>0</value> <!-- OFF -->
				<value>1</value> <!-- SBY -->
				<value>4</value> <!-- ON  -->
				<value>5</value> <!-- ALT -->
				<wrap>false</wrap>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>kt74_mode</tooltip-id>
				<label>Transponder: %s</label>
				<property>instrumentation/transponder/inputs/knob-mode</property>
				<mapping>nasal</mapping>
				<script>
					var modes = ['OFF', 'STBY', 'TEST', 'GND', 'ON', 'ALT'];
					return modes[arg[0]];
				</script>
			</binding>
		</hovered>
	</animation>
	
