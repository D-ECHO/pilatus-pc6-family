		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>vfrbutt</tooltip-id>
				<label>Set 1200</label>
			</binding>
		</hovered>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>kt74.btn.vfr</object-name>
		<object-name>kt74.btn.vfr.lit</object-name>
		<property>instrumentation/transponder/inputs/button-vfr</property>
		<factor>-0.0015</factor>
		<axis>
			<x>1</x>
		</axis>
	</animation>
	
	
	<animation>
		<type>pick</type>
		<object-name>kt74.glass</object-name>
		<action></action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>xpdr</tooltip-id>
				<label>%s</label>
				<property>instrumentation/transponder/inputs/knob-mode</property>
				<mapping>nasal</mapping>
				<script>
					var modes = ['OFF', 'STBY', 'TEST', 'GND', 'ON', 'ALT'];
					var code = getprop("instrumentation/transponder/id-code");
					return "Code: " ~ code ~ " Mode: " ~ modes[arg[0]];
				</script>
			</binding>
		</hovered>
	</animation>
	
	<!-- Label Text -->
	<text>
		<name>LabelText</name>
		<type type="string">literal</type>
		<text type="string">Transponder</text>
		<draw-text type="bool">true</draw-text>
		<font>Helvetica.txf</font>
		<character-size type="double">0.020</character-size>
		<character-aspect-ratio type="double">1.0</character-aspect-ratio>
		<axis-alignment>yz-plane</axis-alignment>
		<max-height>0.2</max-height>
		<max-width>0.2</max-width>
		<font-resolution>
			<width type="int">32</width>
			<height type="int">32</height>
		</font-resolution>
		<alignment>center-center</alignment>
		<offsets>
			<x-m> 0.02</x-m>
			<y-m> -0.01 </y-m>
			<z-m> 0.01 </z-m>
		</offsets>
	</text>
	
	<animation>
		<type>material</type>
		<object-name>LabelText</object-name>
		<emission>
			<red>0.7</red>
			<green>0.7</green>
			<blue>0.7</blue>
		</emission>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>LabelText</object-name>
		<condition>
			<property>/sim/panel-hotspots</property>
		</condition>
	</animation>
	
</PropertyList>
