<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
	<path>clock.ac</path>
	<effect>
		<inherits-from>Models/Effects/interior/instrument-glass</inherits-from>
		<object-name>clock.glass</object-name>
	</effect>
	<animation>
		<type>material</type>
		<object-name>clock</object-name>
		<object-name>clock.ring</object-name>
		<object-name>clock.hr</object-name>
		<object-name>clock.min</object-name>
		<object-name>clock.sec</object-name>
		<emission>
			<red>   0.7 </red>
			<green> 0.4 </green>
			<blue>  0.4 </blue>
			<factor-prop>systems/electrical/outputs/instrument-lights-norm</factor-prop>
		</emission>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>clock.hr</object-name>
		<property>instrumentation/clock/indicated-hour</property>
		<factor>30</factor>
		<axis>
			<x> -1 </x>
			<y>  0 </y>
			<z>  0 </z>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>clock.min</object-name>
		<property>instrumentation/clock/indicated-min</property>
		<factor>6</factor>
		<axis>
			<x> -1 </x>
			<y>  0 </y>
			<z>  0 </z>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>clock.sec</object-name>
		<property>instrumentation/clock/indicated-sec</property>
		<factor>6</factor>
		<axis>
			<x> -1 </x>
			<y>  0 </y>
			<z>  0 </z>
		</axis>
	</animation>
</PropertyList>
