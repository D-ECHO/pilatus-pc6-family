<?xml version="1.0"?>
<PropertyList>
	<path>ng.ac</path>
	
	<animation>
		<type>material</type>
		<object-name>ng</object-name>
		<object-name>ng.needle</object-name>
		<object-name>ng.1000</object-name>
		<object-name>ng.100</object-name>
		<object-name>ng.10</object-name>
		<object-name>ng.1</object-name>
		<emission>
			<red>0.28</red>
			<green>0.14</green>
			<blue>0.07</blue>
			<factor-prop>systems/electrical/outputs/instrument-lights-norm</factor-prop>
		</emission>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>ng.needle</object-name>
		<property>instrumentation/n1-indicator/indicated-n1-percent</property>
		<interpolation>
			<entry><ind>0.0</ind><dep>0.0</dep></entry>
			<entry><ind>120.0</ind><dep>210.0</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	
	<animation>
		<type>textranslate</type>
		<object-name>ng.100</object-name>
		<property>instrumentation/n1-indicator/indicated-n1-percent</property>
		<factor>0.001</factor>
		<step>100</step>
		<bias>0.005</bias>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	<animation>
		<type>textranslate</type>
		<object-name>ng.10</object-name>
		<property>instrumentation/n1-indicator/indicated-n1-percent</property>
		<factor>0.01</factor>
		<step>10</step>
		<bias>0.005</bias>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	<animation>
		<type>textranslate</type>
		<object-name>ng.1</object-name>
		<property>instrumentation/n1-indicator/indicated-n1-percent</property>
		<factor>0.1</factor>
		<step>1</step>
		<bias>0.005</bias>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	<animation>
		<type>textranslate</type>
		<object-name>ng.01</object-name>
		<property>instrumentation/n1-indicator/indicated-n1-percent</property>
		<factor>1</factor>
		<step>0.1</step>
		<bias>0.005</bias>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>

	<animation>
		<type>select</type>
		<object-name>ng.100</object-name>
		<object-name>ng.10</object-name>
		<object-name>ng.1</object-name>
		<object-name>ng.01</object-name>
		<object-name>ng.point</object-name>
		<condition>
			<equals>
				<property>instrumentation/n1-indicator/serviceable</property>
				<value>true</value>
			</equals>
		</condition>
	</animation>
</PropertyList>
